<?xml version="1.0" encoding="utf-8"?>
<!-- "Today" highlight for the calendar widget: a brand-filled rounded pill the
     dark day number sits on (RemoteViews sets it via setBackgroundResource). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#8AA0FF" />
    <corners android:radius="9dp" />
</shape>
