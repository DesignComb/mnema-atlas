<?xml version="1.0" encoding="utf-8"?>
<!-- Streak widget (3×3): 🔥 + streak number + habit title/best, a 7×4 dot grid
     of the last 28 days (c0 oldest top-left → c27 today bottom-right) and a
     checked-in-today hint. StreakWidget.java sets all text at runtime; the
     android:text values here are picker-preview only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/streak_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/streak_fire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/streak_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="7"
            android:textColor="#F4F4F7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/streak_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#E8E8EE"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/streak_best"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9A9AA6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/streak_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#9A9AA6"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/streak_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageView android:id="@+id/c0" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c1" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c2" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c3" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c4" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c5" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c6" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <ImageView android:id="@+id/c7" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c8" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c9" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c10" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c11" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c12" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c13" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <ImageView android:id="@+id/c14" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c15" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c16" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c17" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c18" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c19" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c20" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <ImageView android:id="@+id/c21" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c22" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c23" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c24" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c25" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c26" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/c27" android:layout_width="0dp" android:layout_height="18dp" android:layout_weight="1" android:scaleType="center" android:src="@drawable/streak_cell_off" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/streak_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#9A9AA6"
        android:textSize="12sp" />
</LinearLayout>
