<?xml version="1.0" encoding="utf-8"?>
<!-- Journal widget (2×2 default): header (title + date), big mood emoji, energy
     bolts and a snippet of today's entry. All user-visible text is set at
     runtime by JournalWidget.java (the android:text here is picker-preview only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/journal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/journal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="日記"
            android:textColor="#F4F4F7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/journal_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9A9AA6"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/journal_mood"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🙂"
            android:textSize="34sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/journal_energy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEC0FF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/journal_snippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="4"
                android:ellipsize="end"
                android:textColor="#E8E8EE"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/journal_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#9A9AA6"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
