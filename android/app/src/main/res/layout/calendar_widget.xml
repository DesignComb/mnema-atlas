    </LinearLayout>

    <!-- Agenda: the selected day's tasks (TickTick-style). Divider is a
         FrameLayout — a bare <View> is NOT RemoteViews-safe and kills the whole
         widget with "Can't load widget". -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#22FFFFFF" />

    <TextView
        android:id="@+id/ag_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="今天"
        android:textColor="#C8C8D0"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Agenda: 7 morphing slots. A slot is either a section header (ag_secN) or
         an item row (ag_checkN + ag_timeN + ag_titleN) — to-dos complete, habits
         check in. CalendarWidget.java decides at runtime. -->
    <LinearLayout android:id="@+id/ag_row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/ag_sec0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#9A9AA6" android:textSize="10.5sp" android:textStyle="bold" android:visibility="gone" />
        <ImageView android:id="@+id/ag_check0" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_check" android:contentDescription="完成" />
        <TextView android:id="@+id/ag_time0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:textColor="#8AA0FF" android:textSize="11sp" />
        <TextView android:id="@+id/ag_title0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="7dp" android:textColor="#E8E8EE" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
