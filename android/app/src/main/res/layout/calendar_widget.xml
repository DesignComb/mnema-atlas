<?xml version="1.0" encoding="utf-8"?>
<!-- Google-Calendar-style widget. The month grid is FIXED-height (kept as short
     as possible) so stretching the widget grows the AGENDA, which fills the
     remaining height (layout_weight=1) and splits into two columns: 代辦 (left,
     complete) and 打卡 (right, check in). All RemoteViews-safe views; the day
     cells (cell0..41) and the two row pools (lt_*/rt_*) are driven by
     CalendarWidget.java. android:text values are picker-preview only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView android:id="@+id/btn_prev" android:layout_width="28dp" android:layout_height="26dp" android:gravity="center" android:text="‹" android:textColor="#9A9AA6" android:textSize="18sp" />
        <TextView android:id="@+id/cal_month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="月曆" android:textColor="#F4F4F7" android:textSize="14.5sp" android:textStyle="bold" />
        <TextView android:id="@+id/btn_next" android:layout_width="28dp" android:layout_height="26dp" android:gravity="center" android:text="›" android:textColor="#9A9AA6" android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/wd0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="日" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="一" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="二" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="三" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="四" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="五" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="六" android:textColor="#9A9AA6" android:textSize="10sp" />
    </LinearLayout>

    <!-- 6 fixed-height week rows: the calendar stays compact. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="2dp" android:orientation="horizontal">
        <TextView android:id="@+id/cell0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:id="@+id/cell7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:id="@+id/cell14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:id="@+id/cell21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:id="@+id/cell28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal">
        <TextView android:id="@+id/cell35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
        <TextView android:id="@+id/cell41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="1dp" android:gravity="center" android:textColor="#E8E8EE" android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="#22FFFFFF" />

    <TextView
        android:id="@+id/ag_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="今天"
        android:textColor="#C8C8D0"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Agenda fills the remaining height (weight=1) and splits into two
         SCROLLABLE columns: 代辦 (left) + 打卡 (right), each a ListView backed by
         CalendarAgendaService so every item is reachable + actionable on the
         widget (no need to open the app). -->
    <LinearLayout
        android:id="@+id/ag_cols"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/lt_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="代辦" android:textColor="#9A9AA6" android:textSize="10.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ListView android:id="@+id/lt_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
            <TextView android:id="@+id/lt_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#6A6A76" android:textSize="11.5sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginLeft="10dp" android:orientation="vertical">
            <TextView android:id="@+id/rt_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="3dp" android:text="打卡" android:textColor="#9A9AA6" android:textSize="10.5sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <ListView android:id="@+id/rt_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />
            <TextView android:id="@+id/rt_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#6A6A76" android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ag_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#9A9AA6"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
