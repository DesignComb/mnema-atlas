<?xml version="1.0" encoding="utf-8"?>
<!-- TickTick-style calendar widget (4×4): pageable month header + Sunday-start
     6×7 grid of tappable static TextViews (cell0..cell41 — RemoteViews-safe, no
     RemoteViewsService) + an agenda pane for the selected day (ag_row0..3 with
     complete-checkboxes, +N more, empty/holiday line). CalendarWidget.java sets
     every view at runtime; android:text values here are picker-preview only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#9A9AA6"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/cal_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="月曆"
            android:textColor="#F4F4F7"
            android:textSize="14.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btn_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#9A9AA6"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/wd0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="日" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="一" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="二" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="三" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="四" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="五" android:textColor="#9A9AA6" android:textSize="10sp" />
        <TextView android:id="@+id/wd6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="六" android:textColor="#9A9AA6" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="horizontal">
