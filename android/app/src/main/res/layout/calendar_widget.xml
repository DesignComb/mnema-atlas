<?xml version="1.0" encoding="utf-8"?>
<!-- Month-calendar widget (4×3): header + Sunday-start weekday row + a 6×7 grid
     of static TextViews (cell0..cell41 — RemoteViews-safe, no RemoteViewsService).
     CalendarWidget.java sets every cell's text/color/background at runtime; the
     android:text values here are picker-preview only. -->
