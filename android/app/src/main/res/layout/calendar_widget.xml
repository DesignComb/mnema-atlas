        <TextView android:id="@+id/ag_time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:textColor="#8AA0FF" android:textSize="11sp" />
        <TextView android:id="@+id/ag_title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="7dp" android:textColor="#E8E8EE" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
