# ── Frontend (Vite) ─────────────────────────────────────────────
# Safe to ship to the browser. The publishable/anon key only works through RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_or_anon_key

# Where your Cloudflare Worker (MCP + REST) is deployed. Shown on the API-keys screen.
VITE_MCP_URL=https://your-worker.workers.dev/mcp
VITE_REST_URL=https://your-worker.workers.dev/rest

# ── Worker (Cloudflare) — NEVER expose these to the browser ──────
# Put these in `worker/.dev.vars` for local dev and `wrangler secret put` for prod.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxx        # service-role / secret key — BYPASSES RLS, server-only
